# Optional premium registry credential. Public MIT source excludes premium
# REUI blocks/icons/templates unless written redistribution rights permit them.
# Never use a VITE_ prefix for these secrets.
REUI_LICENSE_KEY=

# Optional headless MCP personal token. The committed MCP entry uses OAuth;
# switch to bearer_token_env_var only when deliberately selecting token auth.
REUI_MCP_TOKEN=
